          "洞内搜索",
          "接近目标",
          "准备停止",
          "暂无法确认"
        ]
      },
      "observation": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      },
      "decision_reason": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      },
      "action_intent": {
        "type": "string",
        "enum": [
          "move_forward",
          "turn_left",
          "turn_right",
          "explore",
          "stop",
          "hold"
        ]
      }
    }
  },
